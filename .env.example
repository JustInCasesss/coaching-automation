# =============================================================================
# Coaching Institute WhatsApp Automation - environment
# Copy to .env and fill in. NEVER commit the filled-in file.
# =============================================================================

# --- WhatsApp Cloud API (Meta) -----------------------------------------------
# Leave WHATSAPP_TOKEN / WHATSAPP_PHONE_NUMBER_ID empty to stay in DEMO MODE:
# every message is logged and written to data/outbox.jsonl, nothing is sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-this-to-a-long-random-string
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=en

# --- Server ------------------------------------------------------------------
PORT=8080
# Required once you are live. Sent as the X-Admin-Token header on /admin/* routes.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
COACH_VERBOSE=0
COACH_DEMO_MODE=

# --- Paths (defaults are fine for a single-box deploy) -----------------------
COACH_DB=./data/coaching.db
COACH_OUTBOX=./data/outbox.jsonl
COACH_CONFIG=./config/institute.json
COACH_DATA_DIR=./data
COACH_OUT_DIR=./out

# --- n8n workflow env vars (import the JSONs from ./n8n) ---------------------
COACHING_BOT_URL=https://bot.yourinstitute.in
COACHING_ADMIN_TOKEN=
OWNER_ALERT_PHONE=+91XXXXXXXXXX
ACCOUNTS_ALERT_PHONE=+91XXXXXXXXXX
INSTITUTE_NAME=Your Institute Name
PAYMENT_WEBHOOK_SECRET=
CRM_SHEET_ID=
REMINDER_LOG_SHEET_ID=
DAILY_TIP_MESSAGE=
DAILY_TIP_COURSE=
