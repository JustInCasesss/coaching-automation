# Copy to .env and replace every placeholder before deployment.
# Generate a strong admin token with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"

# Required: unique random secret, at least 24 characters.
ADMIN_TOKEN=

# Use true for a safe demo. Set false only after all live credentials and
# Meta webhook security/template configuration have been verified.
COACH_DEMO_MODE=true

# Institute configuration and durable data location.
COACH_CONFIG=./config/institute.json
COACH_DB=./data/coaching.db
COACH_OUTBOX=./data/outbox.jsonl
COACH_DATA_DIR=./data
COACH_OUT_DIR=./out
PORT=8080
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Meta WhatsApp Cloud API. Leave token and phone number ID empty for dry-run.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v26.0
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_TEMPLATE_LANG=en_US

# Must be the exact name of an approved Meta template with five body variables:
# student name, amount, due date, reminder stage, institute name.
WHATSAPP_REMINDER_TEMPLATE=

# Caddy: use your public domain here for automatic HTTPS. Keep localhost for
# local testing only.
BOT_HOST=localhost
