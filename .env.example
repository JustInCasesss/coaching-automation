# =============================================================================
# Coaching Institute WhatsApp Automation - environment
# Copy to .env and fill in:   cp .env.example .env
# NEVER commit the filled-in .env file.
# =============================================================================

# --- WhatsApp Cloud API (Meta) -----------------------------------------------
# Leave WHATSAPP_TOKEN / WHATSAPP_PHONE_NUMBER_ID empty to stay in DEMO MODE:
# every message is logged and written to data/outbox.jsonl, nothing is sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-this-to-a-long-random-string
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=en

# --- Server ------------------------------------------------------------------
PORT=8080
# REQUIRED (docker compose refuses to start without it).
# Sent as the X-Admin-Token header on /admin/* routes.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
COACH_VERBOSE=0
# Set to true for demos / Render free tier. Leave empty for a live deployment.
COACH_DEMO_MODE=

# --- Paths (for running WITHOUT Docker) --------------------------------------
# docker-compose.yml overrides these to /data so the database lives in the
# persistent volume. Only change them for a bare-metal / local run.
COACH_DB=./data/coaching.db
COACH_OUTBOX=./data/outbox.jsonl
COACH_CONFIG=./config/institute.json
COACH_DATA_DIR=./data
COACH_OUT_DIR=./out

# --- Docker Compose deploy (Caddy + n8n) -------------------------------------
BOT_HOST=bot.yourinstitute.in
N8N_HOST=n8n.yourinstitute.in
# REQUIRED: pin n8n to a specific released version (see n8n release notes),
# e.g. N8N_VERSION=1.xx.x  -- do not use "latest" in production.
N8N_VERSION=

# --- n8n workflow env vars (import the JSONs from ./n8n) ---------------------
# Inside Docker the bot is reachable at http://bot:8080 (default if left empty).
COACHING_BOT_URL=
# Leave empty to reuse ADMIN_TOKEN (they must match).
COACHING_ADMIN_TOKEN=
OWNER_ALERT_PHONE=+91XXXXXXXXXX
ACCOUNTS_ALERT_PHONE=+91XXXXXXXXXX
INSTITUTE_NAME=Your Institute Name
PAYMENT_WEBHOOK_SECRET=
CRM_SHEET_ID=
REMINDER_LOG_SHEET_ID=
DAILY_TIP_MESSAGE=
DAILY_TIP_COURSE=
